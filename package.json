{
  "name": "follow-me",
  "private": true,
  "version": "0.8.1",
  "description": "Follow Me: Walk with Jesus — a Bible game by Third Heaven Studios",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "check": "node tools/check-content.mjs",
    "voices": "node tools/generate-voices.mjs",
    "build": "node tools/check-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-pwa": "^0.21.1"
  }
}
